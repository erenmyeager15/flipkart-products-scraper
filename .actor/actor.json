{
  "actorSpecification": 1,
  "name": "flipkart-products-scraper",
  "title": "Flipkart Products Scraper - Prices & Search Data",
  "description": "Scrape public Flipkart product search results: title, price, original price, discount, ratings, reviews, specs, image, product ID, and URL. No login needed.",
  "version": "1.0",
  "categories": ["ECOMMERCE", "LEAD_GENERATION", "OTHER"],
  "dockerfile": "Dockerfile",
  "input": "../INPUT_SCHEMA.json",
  "storages": {
    "dataset": {
      "actorSpecification": 1,
      "views": {
        "products": {
          "title": "Products",
          "transformation": {
            "fields": ["imageUrl", "searchQuery", "position", "productId", "title", "price", "priceDisplay", "originalPrice", "originalPriceDisplay", "discountPercent", "rating", "ratingCount", "reviewCount", "specifications", "productUrl", "scrapedAt"]
          },
          "display": {
            "component": "table",
            "properties": {
              "imageUrl": { "label": "Image", "format": "image" },
              "searchQuery": { "label": "Search", "format": "text" },
              "position": { "label": "Position", "format": "number" },
              "productId": { "label": "Product ID", "format": "text" },
              "title": { "label": "Title", "format": "text" },
              "price": { "label": "Price", "format": "number" },
              "priceDisplay": { "label": "Price Text", "format": "text" },
              "originalPrice": { "label": "Original Price", "format": "number" },
              "originalPriceDisplay": { "label": "Original Price Text", "format": "text" },
              "discountPercent": { "label": "Discount %", "format": "number" },
              "rating": { "label": "Rating", "format": "number" },
              "ratingCount": { "label": "Ratings", "format": "number" },
              "reviewCount": { "label": "Reviews", "format": "number" },
              "specifications": { "label": "Specs", "format": "array" },
              "productUrl": { "label": "URL", "format": "link" },
              "scrapedAt": { "label": "Scraped At", "format": "date" }
            }
          }
        }
      }
    }
  },
  "pricingInfo": {
    "pricingModel": "PAY_PER_EVENT",
    "reasonForChange": "Initial pay-per-event pricing for clean Flipkart product records.",
    "pricingPerEvent": {
      "actorChargeEvents": {
        "product-scraped": {
          "eventTitle": "Product scraped",
          "eventDescription": "Charged once for each clean Flipkart product record saved to the dataset.",
          "eventPriceUsd": 0.002
        }
      }
    }
  },
  "defaultRunOptions": {
    "build": "latest",
    "memoryMbytes": 512,
    "timeoutSecs": 3600
  },
  "minMemoryMbytes": 256,
  "maxMemoryMbytes": 2048
}
